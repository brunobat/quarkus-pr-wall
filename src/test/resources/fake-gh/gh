#!/usr/bin/env bash
# Stand-in for the gh CLI in tests. Answers `gh pr view <n> ...` and `gh pr diff <n> ...` from
# prs/<n>/ next to this script:
#   view.json   output of `gh pr view`
#   diff.patch  output of `gh pr diff`
#   error.txt   if present, printed to stderr and the command exits 1
#   diff-error.txt  like error.txt, for `gh pr diff` only (`gh pr view` still answers)
#   sleep       if present, the script first waits on a child `sleep` of that many seconds, which keeps
#               stdout/stderr open; its pid is logged as `sleep-pid <pid>` in the call log
# Every invocation is appended to the call log, target/fake-gh-calls.log in the project, so the build output
# holds it and `mvn clean` clears it.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
log="$here/../../../../target/fake-gh-calls.log"
mkdir -p "$(dirname "$log")"
echo "$*" >> "$log"

[[ "${1:-}" == "pr" ]] || { echo "fake gh: unsupported command: $*" >&2; exit 2; }
sub="${2:-}"
pr="${3:-}"
dir="$here/prs/$pr"

if [[ -f "$dir/sleep" ]]; then
  sleep "$(cat "$dir/sleep")" &
  echo "sleep-pid $!" >> "$log"
  wait
fi
if [[ -f "$dir/error.txt" ]]; then
  cat "$dir/error.txt" >&2
  exit 1
fi
[[ -d "$dir" ]] || { echo "no pull requests found for branch \"$pr\"" >&2; exit 1; }

if [[ "$sub" == "diff" && -f "$dir/diff-error.txt" ]]; then
  cat "$dir/diff-error.txt" >&2
  exit 1
fi

case "$sub" in
  view) cat "$dir/view.json" ;;
  diff) cat "$dir/diff.patch" ;;
  *) echo "fake gh: unsupported subcommand: $sub" >&2; exit 2 ;;
esac
