#!/usr/bin/env bash
# Stand-in for the gh CLI in tests. Answers `gh pr view <n> ...` and `gh pr diff <n> ...` from
# prs/<n>/ next to this script; a number without prs/<n>/ fails as real gh does for a number that is not a PR. `gh pr view` picks its file from the `--json` field list:
#   view.json      fields without additions, statusCheckRollup or comments (the metadata call)
#   size.json      fields containing additions
#   checks.json    fields containing statusCheckRollup
#   comments.json  fields containing comments
#   authorship.json  fields containing commits
#   <stem>-error.txt  if present, `gh pr view` prints it to stderr and exits 1 instead of answering from <stem>.json;
#                  a missing <stem>.json also exits 1
#   diff.patch  output of `gh pr diff`
#   diff-error.txt  if present, `gh pr diff` prints it to stderr and exits 1 (`gh pr view` still answers)
#   sleep       if present, the script first waits on a child `sleep` of that many seconds, which keeps
#               stdout/stderr open; its pid is logged as `sleep-pid <pid>` in the call log
# `gh pr list --search "<n1> <n2> ..." --json number,<fields>` answers from the same files, one JSON array entry per
# searched PR, with "number" added, picking the stem from the fields as `gh pr view` does:
#   list-<stem>.json  if present, used instead of <stem>.json (e.g. a list cut off at 100)
#   skip-list         if present, the PR is left out of every list
#   extra-list        if present, the PR it names is added too, though nobody searched for it
#   list-error.txt    if present in any searched PR, `gh pr list` prints it to stderr and exits 1
#   A PR without <stem>.json, or with <stem>-error.txt, is left out.
# `gh api <path> ...` answers GET paths, printing what `--jq` would have selected:
#   repos/<owner>/<repo>/pulls/<n>  prs/<n>/api-pulls.txt; api-pulls-error.txt instead prints it to stderr and exits 1;
#                  api-pulls-sleep first waits that many seconds, like `sleep`. With -i, prints a status line and a
#                  blank line first: `HTTP/2.0 200 OK` when api-pulls.txt exists; with api-pulls-error.txt, no status
#                  (as for a network failure); otherwise `HTTP/2.0 404 Not Found`, `gh: Not Found (HTTP 404)` on
#                  stderr and exit 1, as GitHub answers for a number that is not a pull request
#   orgs/<owner>/members/<login>  with -i, prints `HTTP/2.0 <status>` from api/members/<login>/status (404 when there is
#                  none) and a blank line; a status other than 2xx also prints `gh: ... (HTTP <status>)` to stderr and
#                  exits 1
#   repos/<owner>/<repo>/commits?author=<login>&sha=...&per_page=1  api/commits/<login>/body.json (`[]` when there is
#                  none); api/commits/<login>/error.txt instead prints it to stderr and exits 1
#   repos/<owner>/<repo>/commits/<sha>/check-suites?per_page=100  api/check-suites/<sha>/body.json
#                  (`{"total_count":0,"check_suites":[]}` when there is none); api/check-suites/<sha>/error.txt
#                  instead prints it to stderr and exits 1
#   any other path exits 2
# Every invocation is appended to the call log, target/fake-gh-calls.log in the project, so the build output
# holds it and `mvn clean` clears it.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
log="$here/../../../../target/fake-gh-calls.log"
mkdir -p "$(dirname "$log")"
echo "$*" >> "$log"

if [[ "${1:-}" == "api" ]]; then
  path="${2:-}"
  if [[ "$path" =~ ^repos/[^/]+/[^/]+/pulls/([0-9]+)$ ]]; then
    d="$here/prs/${BASH_REMATCH[1]}"
    if [[ -f "$d/api-pulls-sleep" ]]; then
      sleep "$(cat "$d/api-pulls-sleep")"
    fi
    if [[ -f "$d/api-pulls-error.txt" ]]; then
      cat "$d/api-pulls-error.txt" >&2
      exit 1
    fi
    include=false
    for arg in "$@"; do [[ "$arg" == "-i" ]] && include=true; done
    if [[ ! -f "$d/api-pulls.txt" ]]; then
      $include && printf 'HTTP/2.0 404 Not Found\n\n{"message":"Not Found","status":"404"}\n'
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi
    $include && printf 'HTTP/2.0 200 OK\n\n'
    cat "$d/api-pulls.txt"
    exit 0
  fi
  if [[ "$path" =~ ^orgs/[^/]+/members/([^/?]+)$ ]]; then
    d="$here/api/members/${BASH_REMATCH[1]}"
    status=404
    [[ -f "$d/status" ]] && status="$(tr -d '[:space:]' < "$d/status")"
    printf 'HTTP/2.0 %s\n\n' "$status"
    if [[ "$status" != 2* ]]; then
      echo "gh: HTTP error (HTTP $status)" >&2
      exit 1
    fi
    exit 0
  fi
  if [[ "$path" =~ ^repos/[^/]+/[^/]+/commits\?author=([^\&]+)\& ]]; then
    d="$here/api/commits/${BASH_REMATCH[1]}"
    if [[ -f "$d/error.txt" ]]; then
      cat "$d/error.txt" >&2
      exit 1
    fi
    if [[ -f "$d/body.json" ]]; then cat "$d/body.json"; else echo '[]'; fi
    exit 0
  fi
  if [[ "$path" =~ ^repos/[^/]+/[^/]+/commits/([0-9a-f]{40})/check-suites\?per_page=100$ ]]; then
    d="$here/api/check-suites/${BASH_REMATCH[1]}"
    if [[ -f "$d/error.txt" ]]; then
      cat "$d/error.txt" >&2
      exit 1
    fi
    if [[ -f "$d/body.json" ]]; then cat "$d/body.json"; else echo '{"total_count":0,"check_suites":[]}'; fi
    exit 0
  fi
  echo "fake gh: unsupported api path: $path" >&2
  exit 2
fi

[[ "${1:-}" == "pr" ]] || { echo "fake gh: unsupported command: $*" >&2; exit 2; }
sub="${2:-}"

# The value after --json and --search, if any.
fields=""
search=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ "${args[$i]}" == "--json" ]] && fields="${args[$((i + 1))]:-}"
  [[ "${args[$i]}" == "--search" ]] && search="${args[$((i + 1))]:-}"
done

view_stem() {
  case ",$fields," in
    *,additions,*) echo size ;;
    *,statusCheckRollup,*) echo checks ;;
    *,comments,*) echo comments ;;
    *,commits,*) echo authorship ;;
    *) echo view ;;
  esac
}

# One list entry: the PR's <stem> JSON object with "number" added, or nothing.
list_entry() {
  local n="$1" stem="$2" d="$here/prs/$1" file
  [[ -d "$d" && ! -f "$d/$stem-error.txt" ]] || return 0
  file="$d/list-$stem.json"
  [[ -f "$file" ]] || file="$d/$stem.json"
  [[ -f "$file" ]] || return 0
  local body
  body="$(cat "$file")"
  body="${body#*\{}"
  printf '{"number":%s,%s' "$n" "$body"
}

if [[ "$sub" == "list" ]]; then
  stem="$(view_stem)"
  wanted=()
  for n in $search; do
    [[ -f "$here/prs/$n/list-error.txt" ]] && { cat "$here/prs/$n/list-error.txt" >&2; exit 1; }
    [[ -f "$here/prs/$n/skip-list" ]] || wanted+=("$n")
    [[ -f "$here/prs/$n/extra-list" ]] && wanted+=("$(tr -d '[:space:]' < "$here/prs/$n/extra-list")")
  done
  entries=()
  for n in "${wanted[@]}"; do
    entry="$(list_entry "$n" "$stem")"
    [[ -n "$entry" ]] && entries+=("$entry")
  done
  (IFS=,; echo "[${entries[*]}]")
  exit 0
fi

pr="${3:-}"
dir="$here/prs/$pr"

if [[ -f "$dir/sleep" ]]; then
  sleep "$(cat "$dir/sleep")" &
  echo "sleep-pid $!" >> "$log"
  wait
fi
[[ -d "$dir" ]] || { echo "GraphQL: Could not resolve to a PullRequest with the number of $pr. (repository.pullRequest)" >&2; exit 1; }

if [[ "$sub" == "diff" && -f "$dir/diff-error.txt" ]]; then
  cat "$dir/diff-error.txt" >&2
  exit 1
fi

case "$sub" in
  view)
    stem="$(view_stem)"
    if [[ -f "$dir/$stem-error.txt" ]]; then
      cat "$dir/$stem-error.txt" >&2
      exit 1
    fi
    [[ -f "$dir/$stem.json" ]] || { echo "fake gh: no $stem.json for PR $pr" >&2; exit 1; }
    cat "$dir/$stem.json"
    ;;
  diff) cat "$dir/diff.patch" ;;
  *) echo "fake gh: unsupported subcommand: $sub" >&2; exit 2 ;;
esac
