+package io.quarkus.smallrye.health.test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+class HealthGroupNameTest {
+
+    @Test
+    void stripsTheLeadingSlash() {
+        assertEquals("ready", handler.groupName("/q/health/group/ready"));
+    }
+
+    @Test
+    void handlesAGroupAtTheRoot() {
+        assertEquals("ready", handler.groupName("/ready"));
+    }
+
+    @Test
+    void handlesAnEmptyTrailingSegment() {
+        assertEquals("", handler.groupName("/q/health/group/"));
+    }
+
+    @Test
+    void rejectsANullPath() {
+        assertThrows(NullPointerException.class, () -> handler.groupName(null));
+    }
+}
